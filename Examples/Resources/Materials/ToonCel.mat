material {
    name : ToonCel,
    shadingModel : unlit,
    culling : back,
    parameters : [
        {
            type : float4,
            name : baseColor
        },
        {
            type : float3,
            name : lightColor
        },
        {
            type : float3,
            name : shadowColorMultiplier
        },
        {
            type : float3,
            name : lightDirection
        },
        {
            type : float,
            name : shadowThreshold
        },
        {
            type : float,
            name : highlightThreshold
        },
        {
            type : float,
            name : feather
        },
        {
            type : int,
            name : halftoneMode
        },
        {
            type : int,
            name : halftoneTarget
        },
        {
            type : float,
            name : halftoneScale
        },
        {
            type : float,
            name : halftoneAngle
        },
        {
            type : float,
            name : halftoneDotSize
        },
        {
            type : float,
            name : halftoneHardness
        },
        {
            type : float,
            name : halftoneBlend
        },
        {
            type : float4,
            name : halftoneDotColor
        },
        {
            type : float4,
            name : halftonePaperColor
        },
        {
            type : float,
            name : hatchJitter
        },
        {
            type : int,
            name : hatchLayers
        },
        {
            type : float,
            name : hatchThreshold1
        },
        {
            type : float,
            name : hatchThreshold2
        },
        {
            type : float,
            name : hatchThreshold3
        }
    ],
    requires : [
        position,
        tangents,
        uv0
    ]
}

fragment {
    // Evaluates a single rotated grid dot mask in [0.0, 1.0]
    float evalHalftoneDot(vec2 p, float angleDeg, float scale, float darkness, float dotSize, float hardness) {
        float rad = radians(angleDeg);
        mat2 rot = mat2(cos(rad), -sin(rad), sin(rad), cos(rad));
        vec2 grid = (rot * p) / max(1.0, scale);
        vec2 cellOffset = fract(grid) - 0.5;
        float distToCenter = length(cellOffset);
        float fw = fwidth(distToCenter);
        float targetRadius = clamp(darkness, 0.0, 1.0) * 0.7071 * dotSize;
        float eps = max(0.005, (1.0 - hardness) * 0.15 + fw);
        return 1.0 - smoothstep(targetRadius - eps, targetRadius + eps, distToCenter);
    }

    // Evaluates a single rotated grid line mask for hatching in [0.0, 1.0] with optional hand wobble
    float evalHalftoneLine(vec2 p, float angleDeg, float scale, float darkness, float lineSize, float hardness, float jitter) {
        float rad = radians(angleDeg);
        mat2 rot = mat2(cos(rad), -sin(rad), sin(rad), cos(rad));
        vec2 pRot = rot * p;

        if (jitter > 0.001) {
            float wobble = sin(pRot.x * 0.05 + pRot.y * 0.02) * jitter * 2.2;
            pRot.y += wobble;
        }

        vec2 grid = pRot / max(1.0, scale);
        float distToLine = abs(fract(grid.y) - 0.5);
        float fw = fwidth(distToLine);
        float targetWidth = clamp(darkness, 0.0, 1.0) * 0.5 * lineSize;
        float eps = max(0.005, (1.0 - hardness) * 0.15 + fw);
        return 1.0 - smoothstep(targetWidth - eps, targetWidth + eps, distToLine);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Normalize geometric normal and light direction
        vec3 N = normalize(getWorldGeometricNormalVector());
        vec3 L = normalize(materialParams.lightDirection);

        // Lambertian cosine law: N dot L in range [-1.0, 1.0]
        float nDotL = dot(N, L);

        // Anti-aliased thresholding using smoothstep
        float eps = max(materialParams.feather, 0.001);

        // Shadow to midtone factor
        float shadowFactor = smoothstep(materialParams.shadowThreshold - eps,
                                        materialParams.shadowThreshold + eps,
                                        nDotL);

        // Midtone to highlight factor
        float highlightFactor = smoothstep(materialParams.highlightThreshold - eps,
                                           materialParams.highlightThreshold + eps,
                                           nDotL);

        // Cartoon cel color tiers:
        vec3 shadowColor = materialParams.baseColor.rgb * materialParams.shadowColorMultiplier;
        vec3 midtoneColor = materialParams.baseColor.rgb;
        vec3 highlightColor = materialParams.baseColor.rgb * materialParams.lightColor;

        vec3 diffuseTone = mix(shadowColor, midtoneColor, shadowFactor);
        vec3 celRgb = mix(diffuseTone, highlightColor, highlightFactor);

        int mode = materialParams.halftoneMode;
        if (mode <= 0) {
            material.baseColor = vec4(celRgb, materialParams.baseColor.a);
            return;
        }

        vec2 coord;
        if (mode == 2) {
            coord = getUV0() * (materialParams.halftoneScale * 10.0);
        } else {
            coord = gl_FragCoord.xy;
        }

        float darkness;
        int target = materialParams.halftoneTarget;
        if (target == 0) {
            darkness = 1.0 - shadowFactor;
        } else if (target == 2) {
            darkness = highlightFactor;
        } else {
            float normalizedLight = clamp((nDotL + 1.0) * 0.5, 0.0, 1.0);
            darkness = 1.0 - normalizedLight;
        }

        vec3 halftoneRgb;
        float scale = max(2.0, materialParams.halftoneScale);
        float baseAngle = materialParams.halftoneAngle;
        float dotSize = max(0.05, materialParams.halftoneDotSize);
        float hardness = clamp(materialParams.halftoneHardness, 0.0, 1.0);
        vec3 dotColor = materialParams.halftoneDotColor.rgb;
        vec3 paperColor = materialParams.halftonePaperColor.rgb;

        if (mode == 3) {
            // CMYK 4-color process separation
            vec3 cmykSource = (target == 1) ? materialParams.baseColor.rgb * clamp((nDotL + 1.0) * 0.5, 0.15, 1.0) : celRgb;
            float k = 1.0 - max(max(cmykSource.r, cmykSource.g), cmykSource.b);
            float c = (1.0 - cmykSource.r - k) / max(0.0001, 1.0 - k);
            float m = (1.0 - cmykSource.g - k) / max(0.0001, 1.0 - k);
            float y = (1.0 - cmykSource.b - k) / max(0.0001, 1.0 - k);

            float cMask = evalHalftoneDot(coord, baseAngle + 15.0, scale, c, dotSize, hardness);
            float mMask = evalHalftoneDot(coord, baseAngle + 75.0, scale, m, dotSize, hardness);
            float yMask = evalHalftoneDot(coord, baseAngle + 0.0,  scale, y, dotSize, hardness);
            float kMask = evalHalftoneDot(coord, baseAngle + 45.0, scale, k, dotSize, hardness);

            vec3 cmykResult = paperColor;
            cmykResult.r *= (1.0 - cMask);
            cmykResult.g *= (1.0 - mMask);
            cmykResult.b *= (1.0 - yMask);
            cmykResult *= (1.0 - kMask);
            halftoneRgb = cmykResult;
        } else if (mode == 4) {
            // Hatching / Engraving Lines
            float lineMask = evalHalftoneLine(coord, baseAngle, scale, darkness, dotSize, hardness, 0.0);
            if (darkness > 0.65) {
                float crossMask = evalHalftoneLine(coord, baseAngle + 60.0, scale, (darkness - 0.65) * 2.5, dotSize, hardness, 0.0);
                lineMask = max(lineMask, crossMask);
            }
            vec3 bgTone = (target == 1) ? paperColor : celRgb;
            halftoneRgb = mix(bgTone, dotColor, lineMask);
        } else if (mode == 5) {
            // Mode 5: Pure Handdrawn Technical Sketch / Architectural Cross-Hatching
            float jitter = materialParams.hatchJitter;
            int layers = max(1, min(4, materialParams.hatchLayers));
            float t1 = materialParams.hatchThreshold1 > 0.0 ? materialParams.hatchThreshold1 : 0.15;
            float t2 = materialParams.hatchThreshold2 > 0.0 ? materialParams.hatchThreshold2 : 0.45;
            float t3 = materialParams.hatchThreshold3 > 0.0 ? materialParams.hatchThreshold3 : 0.70;

            float lineMask = 0.0;

            // Tier 1: Primary directional pencil strokes (e.g. 45°)
            if (darkness > t1) {
                float d1 = clamp((darkness - t1) / max(0.001, 1.0 - t1), 0.0, 1.0);
                float m1 = evalHalftoneLine(coord, baseAngle, scale, d1, dotSize, hardness, jitter);
                lineMask = max(lineMask, m1);
            }

            // Tier 2: Cross-hatching strokes (+60° architectural angle)
            if (layers >= 2 && darkness > t2) {
                float d2 = clamp((darkness - t2) / max(0.001, 1.0 - t2), 0.0, 1.0);
                float m2 = evalHalftoneLine(coord, baseAngle + 60.0, scale, d2, dotSize * 0.95, hardness, jitter * 1.1);
                lineMask = max(lineMask, m2);
            }

            // Tier 3: Dense shadow hatching (-45° counter angle)
            if (layers >= 3 && darkness > t3) {
                float d3 = clamp((darkness - t3) / max(0.001, 1.0 - t3), 0.0, 1.0);
                float m3 = evalHalftoneLine(coord, baseAngle - 45.0, scale, d3, dotSize * 0.90, hardness, jitter * 1.2);
                lineMask = max(lineMask, m3);
            }

            // Tier 4: Core deep shadow stippling / dense cross-weave (90° perpendicular)
            if (layers >= 4 && darkness > 0.88) {
                float d4 = clamp((darkness - 0.88) / 0.12, 0.0, 1.0);
                float m4 = evalHalftoneLine(coord, baseAngle + 90.0, scale * 0.75, d4, dotSize * 1.1, hardness, jitter * 1.3);
                lineMask = max(lineMask, m4);
            }

            // Graphite paper tooth texture modulation
            if (hardness < 0.98) {
                vec2 gridCoord = floor(coord * 0.5);
                float grain = fract(sin(dot(gridCoord, vec2(12.9898, 78.233))) * 43758.5453);
                lineMask *= mix(1.0, 0.75 + 0.35 * grain, 1.0 - hardness);
            }

            vec3 bgTone = (target == 1) ? paperColor : celRgb;
            halftoneRgb = mix(bgTone, dotColor, lineMask);

            // If transparent paper (paperColor.a == 0.0), output alpha based on lineMask
            if (materialParams.halftonePaperColor.a < 0.01 && target == 1) {
                float finalAlpha = clamp(lineMask * materialParams.halftoneDotColor.a, 0.0, 1.0);
                material.baseColor = vec4(dotColor, finalAlpha);
                return;
            }
        } else {
            // Standard Dots (Screen-space or UV surface)
            float dotMask = evalHalftoneDot(coord, baseAngle, scale, darkness, dotSize, hardness);
            vec3 bgTone = (target == 1) ? paperColor : celRgb;
            halftoneRgb = mix(bgTone, dotColor, dotMask);
        }

        float blend = clamp(materialParams.halftoneBlend, 0.0, 1.0);
        vec3 finalRgb = mix(celRgb, halftoneRgb, blend);

        material.baseColor = vec4(finalRgb, materialParams.baseColor.a);
    }
}
